# Создай приложение на https://dev.twitch.tv/console/apps
# Секреты держи только на сервере — не добавляй их в public/index.html.
TWITCH_CLIENT_ID=вставь_client_id
TWITCH_CLIENT_SECRET=вставь_client_secret
PORT=3000

# Пароли стримеров для музыкального дока: {"логин_канала":"пароль"}
MUSIC_ADMIN_CREDENTIALS={"mychannel":"сложный-пароль"}
# Вход в музыкальный пульт через Twitch (кнопка «Войти через Twitch») работает с теми же TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET.
# ОБЯЗАТЕЛЬНО добавь адрес возврата в OAuth Redirect URLs своего приложения на dev.twitch.tv/console/apps:
#   https://твой-домен/api/music/twitch/callback
# Необязательно: если не задан, адрес берётся из заголовков запроса
# TWITCH_MUSIC_REDIRECT_URI=https://твой-домен/api/music/twitch/callback
# Необязательно: ограничить вход через Twitch списком каналов (через запятую). Пусто — вход открыт любому стримеру для своего канала.
# MUSIC_TWITCH_ALLOWED=mychannel,otherchannel
# Модерация вкладки «Предложка»: логины и пароли модераторов в JSON {"логин":"пароль"}.
# Владелец входит с логином admin и паролем WALL_ADMIN_PASSWORD.
WALL_ADMIN_PASSWORD=пароль_админа
WALL_MODERATORS={"moder1":"пароль-1","moder2":"пароль-2"}
# Папка для данных (на Render — путь к постоянному диску)
# WALL_DATA_DIR=/var/data
# Необязательно: если не задан, адрес берётся из заголовков запроса
# TWITCH_WIDGET_REDIRECT_URI=https://твой-домен/api/twitch-widget/callback
# Необязательно: хранение очередей в Cloudflare R2 вместо файлов
# R2_ACCOUNT_ID= R2_BUCKET_NAME= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY=
