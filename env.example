# Создай приложение на https://dev.twitch.tv/console/apps
# Секреты держи только на сервере — не добавляй их в public/index.html.
TWITCH_CLIENT_ID=вставь_client_id
TWITCH_CLIENT_SECRET=вставь_client_secret
PORT=3000

# Пароли стримеров для музыкального дока: {"логин_канала":"пароль"}
MUSIC_ADMIN_CREDENTIALS={"mychannel":"сложный-пароль"}
# Модерация предложений сообщества
WALL_ADMIN_PASSWORD=пароль_админа
WALL_MODERATORS={"moder1":"пароль"}
# Папка для данных (на Render — путь к постоянному диску)
# WALL_DATA_DIR=/var/data
# Необязательно: если не задан, адрес берётся из заголовков запроса
# TWITCH_WIDGET_REDIRECT_URI=https://твой-домен/api/twitch-widget/callback
# Необязательно: хранение очередей в Cloudflare R2 вместо файлов
# R2_ACCOUNT_ID= R2_BUCKET_NAME= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY=
